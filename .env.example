# Copy this file to .env and fill in your own values.
# Everything here has a sane default except PORTAL_JELLYFIN_URL, which is
# required only if you want visitor sign-in (and therefore requesting games) to
# work at all - leave it blank to run the portal in browse-only mode.

# A long random string used to sign session cookies. Optional: left unset, the
# app generates one on first start and stores it in instance/secret_key (mode
# 0600), which survives restarts on its own. Set it explicitly if you want the
# key somewhere you control, or if you ever run more than one instance against
# the same sessions.
PORTAL_SECRET_KEY=

# Port the app itself listens on. Under docker compose this is the port inside
# the container, which HOST_PORT below is then published as - you normally only
# need to change HOST_PORT there, not this. Defaults to 5001, not 5000, so it
# doesn't collide with status-portal (same author, same server, same default
# otherwise) when both run on the same host.
PORTAL_PORT=5001

# Port exposed on your host machine (docker compose only). Maps to PORTAL_PORT
# inside the container.
HOST_PORT=5001

# Host path to bind-mount as your games folder (docker compose only) - see
# docker-compose.yml's comments for adding more than one (e.g. one per disk).
# Not read by the app itself; only substituted into docker-compose.yml.
# Enter the *container-side* path (/games by default) into the admin UI's
# Folder Scanner page afterward.
GAMES_FOLDER_HOST_PATH=./games

# How many request-handling threads the production server (serve_waitress.py) runs.
PORTAL_WAITRESS_THREADS=8

# Set to true only if a reverse proxy (nginx, Caddy, Cloudflare Tunnel...) sits in
# front of this app. Enables trusting its X-Forwarded-* headers. Leave false if
# the app's port is reachable directly (e.g. bare Tailscale, LAN).
PORTAL_BEHIND_PROXY=false

# Set to true once this is served over HTTPS (directly, or via a TLS-terminating
# reverse proxy) - marks the session cookie Secure. Leave false for plain-HTTP setups.
PORTAL_FORCE_HTTPS_COOKIES=false

# Your Jellyfin server's base URL, e.g. http://jellyfin:8096 (docker) or
# http://192.168.1.10:8096 (LAN). Visitors sign in with their Jellyfin username
# and password - checked live against Jellyfin itself on every sign-in, never
# stored here. Leave blank to disable visitor sign-in (and requesting) entirely;
# search still works.
PORTAL_JELLYFIN_URL=

# HTTP timeout (seconds) for the Jellyfin sign-in call. Raise it if valid logins
# are being reported as "couldn't reach Jellyfin" (a Jellyfin busy transcoding
# can be slow to answer).
PORTAL_JELLYFIN_AUTH_TIMEOUT_SECONDS=10

# Steam search tuning - sane defaults, only worth touching if searches are timing
# out or feel slow.
PORTAL_STEAM_SEARCH_TIMEOUT_SECONDS=6
PORTAL_STEAM_DETAILS_TIMEOUT_SECONDS=4
PORTAL_STEAM_DETAILS_WORKERS=5
PORTAL_STEAM_SEARCH_RESULT_LIMIT=10

# Per-session search rate limit, on top of no-login-required: a search box wired
# to a third-party API is otherwise a free denial-of-service amplifier.
PORTAL_SEARCH_RATE_LIMIT=30
PORTAL_SEARCH_RATE_WINDOW_SECONDS=60

# Games-folder scanner (one subfolder per installed game, matched to a Steam
# AppID) is configured entirely from /admin/scanner in the running app now -
# which folder(s) to scan, the scan interval, and the fuzzy-match threshold
# are all DB settings, editable live, no .env edit or restart needed. Nothing
# to set here. Under Docker, still bind-mount your games folder(s) below
# (GAMES_FOLDER_HOST_PATH) - you just enter the *container-side* path(s) into
# the admin UI afterward instead of an env var. See README's "Games-folder
# scanner" section for the {steamapp-<id>} folder-tagging format and how to
# add more than one folder (e.g. one per disk).

# Log level. Leave blank for the sane per-entry-point default: INFO for
# app.py (dev), WARNING for serve_waitress.py (production) - a production log
# shouldn't be as chatty as a dev session's by default. One of DEBUG, INFO,
# WARNING, ERROR, CRITICAL to override either one, e.g. while troubleshooting.
PORTAL_LOG_LEVEL=
